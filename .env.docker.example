# Copy to .env.local and fill in values before running docker compose.
#
# Required for the frontend (Vite reads this at dev-server startup):
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Required for Convex dev in Docker (non-interactive — run once on your Mac):
#   npx convex deployment token create docker-dev --save-env
CONVEX_DEPLOY_KEY=

# Required for Convex Auth (backend — set in Convex dashboard / convex dev):
# CONVEX_SITE_URL=https://your-deployment.convex.site

# Alternative: isolated anonymous Convex backend (different URL than above):
# CONVEX_AGENT_MODE=anonymous
